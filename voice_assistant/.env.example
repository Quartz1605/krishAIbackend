# Malayalam Voice Assistant Configuration
# Copy this file to .env and fill in your actual values

# =======================
# API KEYS (Choose at least one for each service)
# =======================

# Hugging Face API (Free tier available)
# Get your API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# OpenAI API (Optional, paid service)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Credentials (Optional, for advanced features)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1

# =======================
# VOICE SETTINGS
# =======================

# Text-to-Speech Voice Configuration
TTS_VOICE_NAME=ml-IN-SobhanaNeural
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0

# Speech Recognition
ASR_LANGUAGE_CODE=ml-IN
ASR_MODEL=whisper-small

# =======================
# TRANSLATION SETTINGS
# =======================

TRANSLATION_SOURCE_LANG=ml
TRANSLATION_TARGET_LANG=en

# =======================
# RAG CHATBOT INTEGRATION
# =======================

# Your existing RAG chatbot API endpoint
RAG_API_URL=http://localhost:8000/chat

# Optional: API key for your RAG chatbot
# RAG_API_KEY=your_rag_api_key_here

# Timeout for RAG API calls (seconds)
RAG_TIMEOUT=30

# =======================
# APPLICATION SETTINGS
# =======================

# Maximum audio file size in MB
MAX_AUDIO_SIZE_MB=10

# Temporary files directory
TEMP_DIR=./temp

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Maximum audio duration in seconds
MAX_AUDIO_DURATION_SECONDS=60

# =======================
# CACHE SETTINGS
# =======================

# Enable caching for translations
ENABLE_CACHE=true

# Cache time-to-live in seconds
CACHE_TTL=3600

# =======================
# RATE LIMITING
# =======================

# Maximum requests per window
RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds
RATE_LIMIT_WINDOW=60

# =======================
# SERVER CONFIGURATION
# =======================

# Host and port for the FastAPI server
HOST=0.0.0.0
PORT=8080

# =======================
# NOTES
# =======================

# Free API Options:
# 1. Hugging Face: Free tier with rate limits
# 2. Google Translate: Unofficial API (googletrans library)
# 3. gTTS: Free Google Text-to-Speech
# 4. Edge TTS: Free Microsoft Edge TTS
# 5. SpeechRecognition: Free Google Speech Recognition

# For production deployment:
# - Use environment-specific .env files (.env.production, .env.staging)
# - Store sensitive credentials in secure vaults (e.g., AWS Secrets Manager)
# - Enable HTTPS and proper CORS configuration
# - Set up monitoring and alerting
# - Implement proper backup and disaster recovery
