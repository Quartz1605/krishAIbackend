# OpenAI API Key (not needed when using Ollama)
# OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (Free local LLM - no API key required!)
# Make sure Ollama is installed and running locally
# Download from: https://ollama.ai/

# Vector Database Configuration
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=kerala_farming_kb

# Knowledge Base Configuration
KB_DIRECTORY=./data/kb

# LLM Configuration - Using Ollama
LLM_TYPE=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.1
TOP_K_DOCUMENTS=5

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173

# Text Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

GEMINI_API_KEY = "AIzaSyBAq7abS_LfGxV_6uSYx-C2ReiXks9gHKA"
